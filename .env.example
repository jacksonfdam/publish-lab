# --- Your own site (canonical home of every article) ---
# Local checkout of the site repo and the folder that holds post Markdown
SITE_REPO_DIR=/Volumes/Projects/my-site
SITE_CONTENT_DIR=content/posts
SITE_BASE_URL=https://example.com/posts

# --- dev.to (Settings → Extensions → DEV Community API Keys) ---
DEVTO_API_KEY=

# --- LinkedIn (https://www.linkedin.com/developers/apps) ---
# Products needed: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
# Versioned API header, YYYYMM. Bump every few months; LinkedIn drops old versions.
LINKEDIN_VERSION=202509

# --- Medium ---
# Only works if you already own an integration token (Medium no longer issues new ones).
# Leave empty to fall back to the "Import a story" flow.
MEDIUM_TOKEN=
